rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'bespalicoa@gmail.com';
    }

    match /adb/{document=**} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /membershipApplications/{applicationId} {
      allow create: if request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.locality is string
        && request.resource.data.consent == true
        && request.resource.data.status == 'new';
      allow read, update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
